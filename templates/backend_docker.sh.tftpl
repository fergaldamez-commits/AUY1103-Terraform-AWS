#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

for i in {1..30}; do
  if curl -s -m 2 https://archive.ubuntu.com > /dev/null 2>&1; then break; fi
  sleep 3
done

for i in {1..5}; do
  apt-get update -y && apt-get install -y docker.io && break || sleep 5
done
systemctl enable --now docker

docker run -d \
  --name ${nombre_contenedor} \
  --hostname ${nombre_contenedor} \
  --restart unless-stopped \
  -p ${puerto}:80 \
  ${imagen_docker}
